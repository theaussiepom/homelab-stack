{
  "schema": "homelab-stack-v2",
  "values": {},
  "guests": {
    "dns": {
      "depends_on": [],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "dns-state-adopted-separately"
      ]
    },
    "ingress": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "external-http-backends-prepared",
        "external-tls-trust-reviewed"
      ]
    },
    "postgresql": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared"
      ]
    },
    "mariadb": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared"
      ]
    },
    "influxdb": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared"
      ]
    },
    "identity": {
      "depends_on": [
        "postgresql",
        "ingress"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared"
      ]
    },
    "db-tools": {
      "depends_on": [
        "postgresql",
        "mariadb",
        "ingress",
        "identity"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared"
      ]
    },
    "automation": {
      "depends_on": [
        "mariadb",
        "influxdb",
        "mqtt"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "old-writers-retired",
        "retained-custom-images",
        "ha-config-converted-separately",
        "node-red-login-prepared"
      ]
    },
    "bitwarden": {
      "depends_on": [
        "ingress",
        "mariadb"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "old-writers-retired"
      ]
    },
    "pegaprox": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "initial-account-prepared",
        "database-key-retained"
      ]
    },
    "zigbee2mqtt": {
      "depends_on": [
        "mqtt"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "old-writers-retired",
        "restricted-host-device-capability-registered"
      ]
    },
    "monitoring": {
      "depends_on": [
        "postgresql",
        "ingress"
      ],
      "prerequisites": []
    },
    "music": {
      "depends_on": [
        "dns",
        "ingress"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "old-writers-retired",
        "player-network-prepared"
      ]
    },
    "mqtt": {
      "depends_on": [
        "dns"
      ],
      "prerequisites": [
        "state-and-trust-reviewed",
        "data-prepared",
        "configuration-prepared",
        "old-writers-retired",
        "client-endpoints-prepared"
      ]
    }
  },
  "routes": {
    "homeassistant": {
      "host": "hass.${domains.secondary}",
      "aliases": [
        "${domains.homeassistant}"
      ],
      "target": {
        "endpoint": "automation.homeassistant.web"
      }
    },
    "node-red": {
      "host": "${domains.node_red_alias}",
      "aliases": [
        "${domains.node_red_primary}"
      ],
      "target": {
        "endpoint": "automation.node_red.web"
      }
    },
    "bitwarden": {
      "host": "${domains.bitwarden}",
      "target": {
        "endpoint": "bitwarden.bitwarden.web"
      }
    },
    "db-tools": {
      "host": "${domains.db_tools}",
      "target": {
        "endpoint": "db-tools.cloudbeaver.web"
      },
      "middlewares": [
        "security-headers"
      ]
    },
    "pgadmin-compat": {
      "host": "${domains.pgadmin}",
      "target": {
        "endpoint": "db-tools.cloudbeaver.web"
      },
      "middlewares": [
        "security-headers",
        "db-canonical"
      ]
    },
    "pihole1": {
      "host": "pihole1.${domains.primary}",
      "target": {
        "endpoint": "dns.pihole.web"
      }
    },
    "authentik": {
      "host": "${domains.identity}",
      "target": {
        "endpoint": "identity.authentik.web"
      }
    },
    "influxdb": {
      "host": "influx.${domains.secondary}",
      "target": {
        "endpoint": "influxdb.influxdb.web"
      }
    },
    "pegaprox": {
      "host": "prox.${domains.secondary}",
      "target": {
        "endpoint": "pegaprox.pegaprox.web"
      }
    },
    "zigbee1": {
      "host": "zigbee1.${domains.primary}",
      "target": {
        "endpoint": "zigbee2mqtt.zigbee2mqtt.web"
      }
    },
    "host": {
      "host": "host.${domains.secondary}",
      "target": {
        "url": "https://${addresses.udm}:443"
      },
      "transport": "udm",
      "middlewares": [
        "security-headers",
        "management-clients"
      ]
    },
    "nas": {
      "host": "nas.${domains.secondary}",
      "target": {
        "url": "http://${addresses.nas}:${ports.nas_web}"
      },
      "middlewares": [
        "security-headers",
        "management-clients"
      ],
      "aliases": [
        "nas.${domains.primary}"
      ]
    },
    "pihole2": {
      "host": "pihole2.${domains.primary}",
      "target": {
        "url": "http://${addresses.pironman_apps}:80"
      }
    },
    "zigbee2": {
      "host": "zigbee2.${domains.primary}",
      "target": {
        "url": "http://${addresses.zigbeepi_apps}:8099"
      }
    },
    "thread": {
      "host": "thread.${domains.primary}",
      "target": {
        "url": "http://${addresses.pironman_matter}:8080"
      }
    },
    "matter": {
      "host": "matter.${domains.primary}",
      "target": {
        "url": "http://${addresses.pironman_matter}:5580"
      }
    },
    "proxmox": {
      "host": "proxmox.${domains.secondary}",
      "target": {
        "url": "https://${addresses.pve}:8006"
      },
      "transport": "proxmox",
      "middlewares": [
        "security-headers",
        "management-clients"
      ]
    },
    "music": {
      "host": "${domains.music}",
      "target": {
        "endpoint": "music.music_assistant.web"
      },
      "middlewares": [
        "security-headers",
        "music-clients"
      ]
    }
  },
