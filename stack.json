{
  "schema": "homelab-components-v1",
  "kind": "library",
  "app_profiles": {
    "homeassistant": {
      "source": "apps/homeassistant.yaml"
    },
    "node_red": {
      "source": "apps/node_red.yaml"
    },
    "bitwarden": {
      "source": "apps/bitwarden.yaml"
    },
    "cloudbeaver": {
      "source": "apps/cloudbeaver.yaml"
    },
    "pihole": {
      "source": "apps/pihole.yaml"
    },
    "unbound": {
      "source": "apps/unbound.yaml"
    },
    "authentik": {
      "source": "apps/authentik.yaml"
    },
    "influxdb": {
      "source": "apps/influxdb.yaml"
    },
    "traefik": {
      "source": "apps/traefik.yaml"
    },
    "mariadb": {
      "source": "apps/mariadb.yaml"
    },
    "zabbix": {
      "source": "apps/zabbix.yaml"
    },
    "mqtt": {
      "source": "apps/mqtt.yaml"
    },
    "mqtt_explorer": {
      "source": "apps/mqtt_explorer.yaml"
    },
    "music_assistant": {
      "source": "apps/music_assistant.yaml"
    },
    "pegaprox": {
      "source": "apps/pegaprox.yaml"
    },
    "postgresql": {
      "source": "apps/postgresql.yaml"
    },
    "zigbee2mqtt": {
      "source": "apps/zigbee2mqtt.yaml"
    },
    "winet": {
      "source": "apps/winet.yaml"
    },
    "cloudbeaver-mariadb-admin": {
      "source": "apps/cloudbeaver-mariadb-admin.yaml"
    },
    "music_assistant-split": {
      "source": "apps/music_assistant-split.yaml"
    },
    "influxdb-web": {
      "source": "apps/influxdb-web.yaml"
    },
    "homeassistant-bound": {
      "source": "apps/homeassistant-bound.yaml"
    },
    "node_red-bound": {
      "source": "apps/node_red-bound.yaml"
    },
    "homeassistant-custom": {
      "source": "apps/homeassistant-custom.yaml"
    },
    "node_red-custom": {
      "source": "apps/node_red-custom.yaml"
    },
    "pihole-web": {
      "source": "apps/pihole-web.yaml"
    },
    "homeassistant-dual-web": {
      "source": "apps/homeassistant-dual-web.yaml"
    },
    "scrypted": {
      "source": "apps/scrypted.yaml"
    }
  },
  "guest_templates": {
    "base": {
      "source": "templates/base.yaml"
    },
    "docker": {
      "source": "templates/docker.yaml"
    }
  },
  "software": {
    "docker": {
      "packages": [
        "docker.io=26.1.5+dfsg1-9+deb13u1",
        "docker-cli=26.1.5+dfsg1-9+deb13u1",
        "docker-compose=2.26.1-4"
      ]
    },
    "curl": {
      "packages": [
        "curl=8.14.1-2+deb13u7"
      ]
    },
    "network-tools": {
      "packages": [
        "iproute2=6.15.0-1"
      ]
    },
    "yaml-parser": {
      "packages": [
        "python3-yaml=6.0.2-1+b2"
      ]
    },
    "mariadb-client": {
      "packages": [
        "mariadb-client-core=1:11.8.6-0+deb13u1"
      ]
    },
    "postgresql": {
      "packages": [
        "postgresql-16=16.10-1.pgdg13+1",
        "postgresql-client-16=16.10-1.pgdg13+1",
        "libpq5=16.10-1.pgdg13+1"
      ],
      "repositories": [
        {
          "name": "postgresql",
          "source": "Types: deb\nURIs: https://apt-archive.postgresql.org/pub/repos/apt\nSuites: trixie-pgdg-archive\nComponents: main\nArchitectures: amd64\nSigned-By: /usr/share/keyrings/postgresql.asc\n",
          "key_asset": "postgresql-repository-key"
        }
      ]
    },
    "mariadb": {
      "packages": [
        "mariadb-server=1:12.3.3+maria~deb13",
        "mariadb-client=1:12.3.3+maria~deb13"
      ],
      "repositories": [
        {
          "name": "mariadb",
          "source": "Types: deb\nURIs: https://dlm.mariadb.com/repo/mariadb-server/12.3.3/repo/debian\nSuites: trixie\nComponents: main\nArchitectures: amd64\nSigned-By: /usr/share/keyrings/mariadb.asc\n",
          "key_asset": "mariadb-repository-key"
        }
      ]
    },
    "influxdb": {
      "packages": [
        "influxdb2=2.7.12-1",
        "influxdb2-cli=2.7.5-1"
      ],
      "repositories": [
        {
          "name": "influxdata",
          "source": "Types: deb\nURIs: https://repos.influxdata.com/debian\nSuites: stable\nComponents: main\nArchitectures: amd64\nSigned-By: /usr/share/keyrings/influxdata.asc\n",
          "key_asset": "influxdb-repository-key"
        }
      ]
    },
    "homeassistant-custom-images": {
      "images": {
        "homeassistant": "homeassistant"
      }
    },
    "node_red-custom-images": {
      "images": {
        "node_red": "node_red"
      }
    },
    "bitwarden-images": {
      "images": {
        "bitwarden": "bitwarden"
      }
    },
    "cloudbeaver-images": {
      "images": {
        "cloudbeaver": "cloudbeaver",
        "auth_gateway": "auth_gateway"
      }
    },
    "pihole-images": {
      "images": {
        "pihole": "pihole"
      }
    },
    "unbound-images": {
      "images": {
        "unbound": "unbound"
      }
    },
    "authentik-images": {
      "images": {
        "server": "authentik",
        "worker": "authentik",
        "redis": "redis"
      }
    },
    "traefik-images": {
      "images": {
        "traefik": "traefik"
      }
    },
    "zabbix-images": {
      "images": {
        "zabbix_server": "zabbix_server",
        "zabbix_web": "zabbix_web"
      }
    },
    "mqtt-images": {
      "images": {
        "mqtt": "mqtt"
      }
    },
    "mqtt_explorer-images": {
      "images": {
        "mqtt_explorer": "mqtt_explorer",
        "explorer_gateway": "traefik"
      }
    },
    "music_assistant-images": {
      "images": {
        "music_assistant": "music_assistant"
      }
    },
    "pegaprox-images": {
      "images": {
        "pegaprox": "pegaprox"
      }
    },
    "zigbee2mqtt-images": {
      "images": {
        "zigbee2mqtt": "zigbee2mqtt"
      }
    },
    "winet-images": {
      "images": {
        "winet": "winet"
      }
    },
    "homeassistant-upstream-images": {
      "images": {
        "homeassistant": "homeassistant_upstream"
      }
    },
    "node_red-upstream-images": {
      "images": {
        "node_red": "node_red_upstream"
      }
    },
    "pbs-client": {
      "packages": [
        "proxmox-backup-client=4.2.8-1"
      ],
      "repositories": [
        {
          "name": "pbs-client",
          "source": "Types: deb\nURIs: http://download.proxmox.com/debian/pbs-client\nSuites: trixie\nComponents: main\nArchitectures: amd64\nSigned-By: /usr/share/keyrings/pbs-client.asc\n",
          "key_asset": "proxmox-backup-repository-key"
        }
      ]
    },
    "scrypted-images": {
      "images": {
        "scrypted": "scrypted"
      }
    }
  },
  "runtime_profiles": {
    "container-host": {
      "requirements": {
        "nesting": true,
        "keyctl": false
      }
    },
    "homeassistant": {
      "containers": {
        "homeassistant": {
          "memory_mib": 2048,
          "pids_limit": 512,
          "cpu_limit": 2
        }
      }
    },
    "node_red": {
      "containers": {
        "node_red": {
          "memory_mib": 1024,
          "pids_limit": 256,
          "cpu_limit": 1,
          "user": "node-red"
        }
      }
    },
    "bitwarden": {
      "containers": {
        "bitwarden": {
          "memory_mib": 1536,
          "pids_limit": 256,
          "cpu_limit": 1
        }
      }
    },
    "cloudbeaver": {
      "containers": {
        "cloudbeaver": {
          "memory_mib": 1536,
          "pids_limit": 512,
          "cpu_limit": 1,
          "cap_drop": [
            "ALL"
          ],
          "user": "8978:8978",
          "no_new_privileges": true
        },
        "auth_gateway": {
          "memory_mib": 128,
          "pids_limit": 128,
          "cpu_limit": 1,
          "read_only": true,
          "cap_drop": [
            "ALL"
          ],
          "user": "65532:65532",
          "no_new_privileges": true
        }
      }
    },
    "pihole": {
      "containers": {
        "pihole": {
          "memory_mib": 256,
          "pids_limit": 128,
          "cpu_limit": 1
        }
      }
    },
    "unbound": {
      "containers": {
        "unbound": {
          "memory_mib": 256,
          "pids_limit": 128,
          "cpu_limit": 1
        }
      }
    },
    "authentik": {
      "containers": {
        "server": {
          "memory_mib": 768,
          "pids_limit": 256,
          "cpu_limit": 1,
          "user": "1000"
        },
        "worker": {
          "memory_mib": 768,
          "pids_limit": 256,
          "cpu_limit": 1,
          "user": "1000"
        },
        "redis": {
          "memory_mib": 128,
          "pids_limit": 256,
          "cpu_limit": 1
        }
      }
    },
    "traefik": {
      "containers": {
        "traefik": {
          "memory_mib": 512,
          "pids_limit": 256,
          "cpu_limit": 1
        }
      }
    },
    "zabbix": {
      "containers": {
        "zabbix_server": {
          "memory_mib": 768,
          "pids_limit": 256,
          "cpu_limit": 1
        },
        "zabbix_web": {
          "memory_mib": 512,
          "pids_limit": 256,
          "cpu_limit": 1
        }
      }
    },
    "mqtt": {
      "containers": {
        "mqtt": {
          "memory_mib": 256,
          "pids_limit": 128,
          "cpu_limit": 1
        }
      }
    },
    "mqtt_explorer": {
      "containers": {
        "mqtt_explorer": {
          "memory_mib": 256,
          "pids_limit": 128,
          "cpu_limit": 1,
          "read_only": true,
          "cap_drop": [
            "ALL"
          ],
          "user": "1001:1001",
          "no_new_privileges": true
        },
        "explorer_gateway": {
          "memory_mib": 128,
          "pids_limit": 128,
          "cpu_limit": 1,
          "read_only": true,
          "cap_drop": [
            "ALL"
          ],
          "user": "65532:65532",
          "no_new_privileges": true
        }
      }
    },
    "music_assistant": {
      "containers": {
        "music_assistant": {
          "memory_mib": 1536,
          "pids_limit": 512,
          "cpu_limit": 2
        }
      }
    },
    "pegaprox": {
      "containers": {
        "pegaprox": {
          "memory_mib": 1536,
          "pids_limit": 256,
          "cpu_limit": 2,
          "read_only": true,
          "cap_drop": [
            "ALL"
          ],
          "tmpfs": [
            "/tmp:rw,nosuid,nodev,size=64m"
          ],
          "no_new_privileges": true
        }
      },
      "requirements": {
        "os_reserve_mib": 512
      }
    },
    "zigbee2mqtt": {
      "containers": {
        "zigbee2mqtt": {
          "memory_mib": 512,
          "pids_limit": 128,
          "cpu_limit": 2
        }
      }
    },
    "winet": {
      "containers": {
        "winet": {
          "memory_mib": 256,
          "pids_limit": 128,
          "cpu_limit": 1
        }
      }
    },
    "homeassistant-mdns": {
      "containers": {
        "homeassistant": {
          "cap_add": [
            "NET_ADMIN"
          ]
        }
      }
    },
    "native-postgresql": {
      "native": {
        "memory_mib": 1792
      }
    },
    "native-mariadb": {
      "native": {
        "memory_mib": 768
      }
    },
    "native-influxdb": {
      "native": {
        "memory_mib": 1792
      }
    },
    "scrypted": {
      "containers": {
        "scrypted": {
          "memory_mib": 4096,
          "cpu_limit": 4,
          "pids_limit": 512,
          "user": "0:0"
        }
      }
    }
  },
  "assets": {
    "postgresql-repository-key": {
      "type": "raw-utf8",
      "source": "assets/postgresql/vendor.asc",
      "sha256": "0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76"
    },
    "mariadb-repository-key": {
      "type": "raw-utf8",
      "source": "assets/mariadb/vendor.asc",
      "sha256": "00adb387f4c12e8982cfc28165d225695621494354cd58108c6845063bfb74b5"
    },
    "influxdb-repository-key": {
      "type": "raw-utf8",
      "source": "assets/influxdb/vendor.asc",
      "sha256": "40557e261cdbdccac91a2dde474cbf101ef672661e64b211b711cc0b904d5dac"
    },
    "proxmox-backup-repository-key": {
      "type": "raw-utf8",
      "source": "assets/proxmox-backup/vendor.asc",
      "sha256": "ce59d08e88e5b00dd1740f5ecf09509138fa9962fa1d27518d955b91d1161240"
    }
  },
  "health_profiles": {
    "adapter-ready": {
      "type": "adapter",
      "check": "readiness"
    }
  },
  "policies": {
    "network": {
      "mqtt_backend_ingress": {
        "source": "policies/network/mqtt_backend_ingress.yaml"
      },
      "http_backend_egress": {
        "source": "policies/network/http_backend_egress.yaml"
      },
      "resolver_dns_udp_first": {
        "source": "policies/network/resolver_dns_udp_first.yaml"
      },
      "source_bound_package_image_provider_web_egress": {
        "source": "policies/network/source_bound_package_image_provider_web_egress.yaml"
      },
      "resolver_dns_tcp_first": {
        "source": "policies/network/resolver_dns_tcp_first.yaml"
      },
      "package_repository_web_egress": {
        "source": "policies/network/package_repository_web_egress.yaml"
      },
      "package_image_provider_web_egress": {
        "source": "policies/network/package_image_provider_web_egress.yaml"
      }
    }
  },
  "authentication_profiles": {
    "cloudbeaver-oidc": {
      "type": "cloudbeaver-oidc",
      "required": true
    },
    "node-red-retained-oidc": {
      "type": "node-red-retained-oidc",
      "required": true
    },
    "zabbix-saml": {
      "type": "zabbix-saml",
      "required": false
    }
  },
  "monitoring_profiles": {
    "linux-agent": {
      "type": "zabbix-agent",
      "profiles": [
        "linux"
      ]
    },
    "docker-agent": {
      "type": "zabbix-agent",
      "profiles": [
        "docker"
      ]
    },
    "postgresql-agent": {
      "type": "zabbix-agent",
      "profiles": [
        "postgresql"
      ]
    },
    "mariadb-agent": {
      "type": "zabbix-agent",
      "profiles": [
        "mysql"
      ]
    },
    "influxdb-agent": {
      "type": "zabbix-agent",
      "profiles": [
        "influxdb"
      ]
    }
  },
  "backup_profiles": {
    "pbs-client": {
      "source": "backup/pbs-client.yaml"
    }
  }
}
