{
  "config": {
    "guest": {
      "vmid": "${vmids.ingress}",
      "hostname": "${hostnames.ingress}",
      "cpu": 1,
      "memory_mib": 768,
      "root_gib": 4,
      "storage_id": "${storage.guest}",
      "template_file_id": "${templates.debian_lxc}",
      "started": true,
      "start_on_boot": true,
      "boot_order": 30,
      "nesting": true,
      "keyctl": false,
      "dns_servers": [
        "${addresses.dns}",
        "${addresses.fallback_dns}"
      ],
      "interfaces": [
        {
          "bridge": "${bridges.management}",
          "vlan": "${vlans.management}",
          "mac": "${mac.ingress.0}",
          "ipv4": "${addresses.ingress_management}/${prefixes.management}",
          "ipv6": "manual",
          "gateway": "${gateways.management}"
        },
        {
          "bridge": "${bridges.http_backend}",
          "vlan": "${vlans.http_backend}",
          "mac": "${mac.ingress.1}",
          "ipv4": "${addresses.ingress_backend}/${prefixes.http_backend}",
          "ipv6": "manual"
        },
        {
          "bridge": "${bridges.frontend}",
          "vlan": "${vlans.frontend}",
          "mac": "${mac.ingress.2}",
          "ipv4": "${addresses.ingress_frontend}/${prefixes.frontend}",
          "ipv6": "manual"
        },
        {
          "bridge": "${bridges.influxdb}",
          "vlan": "${vlans.influxdb}",
          "mac": "${mac.ingress.3}",
          "ipv4": "${addresses.ingress_influxdb}/${prefixes.influxdb}",
          "ipv6": "manual"
        }
      ],
      "volumes": {
        "data": {
          "path": "/srv/homelab",
          "size_gib": 2
        }
      },
      "rules": [
        {
          "direction": "in",
          "proto": "tcp",
          "port": "22",
          "comment": "Deployment runner SSH only",
          "source": "${addresses.runner}/32"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "comment": "ACME recursive DNS only",
          "destination": "${addresses.acme_dns_primary}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "comment": "ACME recursive DNS only",
          "destination": "${addresses.acme_dns_primary}/32"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "comment": "ACME recursive DNS only",
          "destination": "${addresses.acme_dns_secondary}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "comment": "ACME recursive DNS only",
          "destination": "${addresses.acme_dns_secondary}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Signed packages, pinned images, provider and HTTPS",
          "destination": "0.0.0.0/0"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.home}/${prefixes.home}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.policy_15}/${prefixes.policy_15}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.management}/${prefixes.management}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Qualified admin VPN HTTPS clients",
          "source": "${networks.admin_vpn}/${prefixes.admin_vpn}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.http_backend}/${prefixes.http_backend}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.frontend}/${prefixes.frontend}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "80,443",
          "comment": "Selected internal HTTPS clients",
          "source": "${networks.policy_50}/${prefixes.policy_50}",
          "destination": "${addresses.ingress_frontend}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8006",
          "comment": "Pinned Proxmox discovery API only",
          "destination": "${addresses.pve}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "9000",
          "comment": "Selected discovered backend",
          "destination": "${addresses.identity_backend}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80",
          "comment": "Selected discovered backend",
          "destination": "${addresses.pgadmin_backend}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8123,1880",
          "comment": "Selected discovered backend",
          "destination": "${addresses.automation_backend}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8080",
          "comment": "Selected discovered backend",
          "destination": "${addresses.bitwarden_backend}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80",
          "source": "${addresses.ingress_frontend}/32",
          "destination": "${addresses.dns}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8099",
          "source": "${addresses.ingress_backend}/32",
          "destination": "${addresses.zigbee_backend}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8086",
          "source": "${addresses.ingress_influxdb}/32",
          "destination": "${addresses.influxdb_backend}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "5000",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.pegaprox_management}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "443",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.udm}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "${ports.nas_web}",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.nas}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80",
          "source": "${addresses.ingress_frontend}/32",
          "destination": "${addresses.pironman_apps}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8099",
          "source": "${addresses.ingress_frontend}/32",
          "destination": "${addresses.zigbeepi_apps}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8080",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.pironman_matter}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "5580",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.pironman_matter}/32",
          "comment": "Declared HTTP route backend"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "8095",
          "comment": "Declared Music Assistant HTTP route backend",
          "source": "${addresses.ingress_management}/32",
          "destination": "${addresses.music_home}/32"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80",
          "source": "${addresses.ingress_backend}/32",
          "destination": "${addresses.mqtt_backend}/32",
          "interface": "net1",
          "comment": "Traefik to the authenticated MQTT Explorer gateway"
        }
      ]
    },
    "app": {
      "kind": "ingress",
      "vmid": "${vmids.ingress}",
      "hostname": "${hostnames.ingress}",
      "memory_mib": 768,
      "address": "${addresses.ingress_management}",
      "mac": "${mac.ingress.0}",
      "packages": [
        "docker.io=26.1.5+dfsg1-9+deb13u1",
        "docker-cli=26.1.5+dfsg1-9+deb13u1",
        "docker-compose=2.26.1-4",
        "curl=8.14.1-2+deb13u7",
        "iproute2=6.15.0-1"
      ],
      "stack_config": "${inputs}/stack.json",
      "exclusive_writer_confirmed": false,
      "health_checks": [
        {
          "name": "Proxy health endpoint",
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "10",
            "http://127.0.0.1:8082/ping"
          ],
          "expect": "OK"
        }
      ],
      "frontend_routing": {
        "address": "${addresses.ingress_frontend}/${prefixes.frontend}",
        "gateway": "${gateways.frontend}",
        "mac": "${mac.ingress.2}"
      },
      "service_health_checks": {
        "traefik": [
          {
            "name": "Proxy health endpoint",
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "10",
              "http://127.0.0.1:8082/ping"
            ],
            "expect": "OK"
          }
        ]
      }
    }
  },
  "files": {},
  "stack": {
    "kind": "ingress",
    "data_root": "/srv/homelab/data",
    "guest_memory_mib": 768,
    "timezone": "${timezones.applications}",
    "services": {
      "traefik": {
        "memory_mib": 512,
        "cpus": 1,
        "pids_limit": 256,
        "environment": {},
        "extra_mounts": [],
        "image_ref": "traefik"
      }
    },
    "foundation": {
      "version": 1,
      "bind_address": "${addresses.ingress_frontend}",
      "proxmox_url": "https://${addresses.pve}:8006",
      "proxmox_token_id": "${identity.discovery_token}",
      "acme_email": "${contact.acme_email}",
      "pve_ca_file": "/usr/local/share/ca-certificates/homelab-pve.crt",
      "secret_files": {
        "proxmox_token": "${inputs}/proxmox-token",
        "cloudflare_dns_token": "${inputs}/cloudflare-dns-token"
      },
      "acme_dns_resolvers": [
        "${addresses.acme_dns_primary}:53",
        "${addresses.acme_dns_secondary}:53"
      ],
      "acme_dns_propagation_timeout_seconds": 2100
    },
    "routing": {
      "middlewares": {
        "management-clients": {
          "ipAllowList": {
            "sourceRange": "${networks.management_clients}"
          }
        },
        "music-clients": {
          "ipAllowList": {
            "sourceRange": "${networks.music_clients}"
          }
        },
        "db-canonical": {
          "redirectRegex": {
            "regex": "^https://[^/]+/(.*)",
            "replacement": "https://${domains.db_tools}/",
            "permanent": false
          }
        }
      },
      "transports": {
        "proxmox": {
          "ca_file": "/usr/local/share/ca-certificates/homelab-pve.crt"
        },
        "udm": {
          "server_name": "${domains.udm_backend}"
        }
      }
    }
  }
}
