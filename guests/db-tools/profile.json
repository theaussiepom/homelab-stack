{
  "config": {
    "guest": {
      "boot_order": 50,
      "cpu": 1,
      "dns_servers": [
        "${addresses.dns}",
        "${addresses.fallback_dns}"
      ],
      "hostname": "db-tools",
      "interfaces": [
        {
          "bridge": "vmbr0",
          "gateway": "${gateways.management}",
          "ipv4": "${addresses.pgadmin_management}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.0}",
          "vlan": 25
        },
        {
          "bridge": "vmbr30",
          "ipv4": "${addresses.pgadmin_backend}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.1}",
          "vlan": null
        },
        {
          "bridge": "vmbr31",
          "ipv4": "${addresses.pgadmin_postgresql}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.2}",
          "vlan": null
        }
      ],
      "keyctl": false,
      "memory_mib": 768,
      "nesting": true,
      "root_gib": 4,
      "rules": [
        {
          "comment": "Deployment runner SSH only",
          "direction": "in",
          "port": "22",
          "proto": "tcp",
          "source": "${addresses.runner}/32"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "udp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "tcp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "udp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "tcp"
        },
        {
          "comment": "Signed packages, pinned images, provider and HTTPS",
          "destination": "0.0.0.0/0",
          "direction": "out",
          "port": "80,443",
          "proto": "tcp"
        },
        {
          "comment": "Traefik backend only",
          "destination": "${addresses.pgadmin_backend}/32",
          "direction": "in",
          "port": "80",
          "proto": "tcp",
          "source": "${addresses.ingress_backend}/32"
        },
        {
          "comment": "postgresql approved client db-tools",
          "destination": "${addresses.postgresql_backend}/32",
          "direction": "out",
          "port": "5432",
          "proto": "tcp",
          "source": "${addresses.pgadmin_postgresql}/32"
        }
      ],
      "start_on_boot": true,
      "started": true,
      "storage_id": "local-zfs",
      "template_file_id": "local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst",
      "vmid": 202,
      "volumes": {
        "data": {
          "path": "/srv/homelab",
          "size_gib": 2
        }
      }
    },
    "app": {
      "address": "${addresses.pgadmin_management}",
      "exclusive_writer_confirmed": false,
      "health_checks": [
        {
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "15",
            "http://${addresses.pgadmin_backend}/login"
          ],
          "expect": "",
          "name": "Preserved pgAdmin profile serves its login"
        },
        {
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "15",
            "--resolve",
            "${domains.identity}:443:${addresses.ingress_frontend}",
            "https://${domains.identity}/application/o/pgadmin4/.well-known/openid-configuration"
          ],
          "expect": "authorization_endpoint",
          "name": "Verified HTTPS identity discovery"
        },
        {
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "15",
            "--resolve",
            "${domains.pgadmin}:443:${addresses.ingress_frontend}",
            "https://${domains.pgadmin}/login"
          ],
          "expect": "",
          "name": "Verified HTTPS pgAdmin route"
        }
      ],
      "hostname": "db-tools",
      "kind": "db-tools",
      "mac": "${mac.db-tools.0}",
      "memory_mib": 768,
      "packages": [
        "docker.io=26.1.5+dfsg1-9+deb13u1",
        "docker-cli=26.1.5+dfsg1-9+deb13u1",
        "docker-compose=2.26.1-4",
        "curl=8.14.1-2+deb13u7"
      ],
      "stack_config": "${inputs}/stack.json",
      "vmid": 202,
      "service_health_checks": {
        "pgadmin": [
          {
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "15",
              "http://${addresses.pgadmin_backend}/login"
            ],
            "expect": "",
            "name": "Preserved pgAdmin profile serves its login"
          },
          {
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "15",
              "--resolve",
              "${domains.identity}:443:${addresses.ingress_frontend}",
              "https://${domains.identity}/application/o/pgadmin4/.well-known/openid-configuration"
            ],
            "expect": "authorization_endpoint",
            "name": "Verified HTTPS identity discovery"
          },
          {
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "15",
              "--resolve",
              "${domains.pgadmin}:443:${addresses.ingress_frontend}",
              "https://${domains.pgadmin}/login"
            ],
            "expect": "",
            "name": "Verified HTTPS pgAdmin route"
          }
        ]
      },
      "endpoints": {
        "pgadmin": {
          "web": "http://${addresses.pgadmin_backend}:80"
        }
      }
    }
  },
  "files": {
    "custody-catalogue.json": "${custody.catalogue}",
    "custody-acceptance.json": "${custody.postgresql_acceptance}"
  },
  "stack": {
    "data_root": "/srv/homelab/data",
    "foundation": {
      "identity_url": "https://${domains.identity}",
      "oauth_client_id": "${identity.pgadmin_client}",
      "oauth_name": "authentik",
      "provider_slug": "pgadmin4",
      "secret_files": {
        "oauth_client_secret": "${inputs}/oauth-client-secret"
      },
      "version": 1
    },
    "guest_memory_mib": 768,
    "kind": "db-tools",
    "pgadmin_bind_address": "${addresses.pgadmin_backend}",
    "services": {
      "pgadmin": {
        "cpus": 1,
        "environment": {},
        "extra_mounts": [],
        "memory_mib": 512,
        "pids_limit": 256,
        "user": "5050",
        "image_ref": "pgadmin"
      }
    },
    "timezone": "Australia/Brisbane"
  }
}
