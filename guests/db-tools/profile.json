{
  "config": {
    "guest": {
      "boot_order": 50,
      "cpu": 1,
      "dns_servers": [
        "${addresses.dns}",
        "${addresses.fallback_dns}"
      ],
      "hostname": "db-tools",
      "interfaces": [
        {
          "bridge": "vmbr0",
          "gateway": "${gateways.management}",
          "ipv4": "${addresses.pgadmin_management}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.0}",
          "vlan": 25
        },
        {
          "bridge": "vmbr30",
          "ipv4": "${addresses.pgadmin_backend}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.1}",
          "vlan": null
        },
        {
          "bridge": "vmbr31",
          "ipv4": "${addresses.pgadmin_postgresql}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.2}",
          "vlan": null
        },
        {
          "bridge": "vmbr32",
          "ipv4": "${addresses.db_tools_mariadb}/24",
          "ipv6": "manual",
          "mac": "${mac.db-tools.3}",
          "vlan": null
        }
      ],
      "keyctl": false,
      "memory_mib": 2048,
      "nesting": true,
      "root_gib": 4,
      "rules": [
        {
          "comment": "Deployment runner SSH only",
          "direction": "in",
          "port": "22",
          "proto": "tcp",
          "source": "${addresses.runner}/32"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "udp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "tcp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "udp"
        },
        {
          "comment": "Existing internal DNS",
          "destination": "${addresses.fallback_dns}/32",
          "direction": "out",
          "port": "53",
          "proto": "tcp"
        },
        {
          "comment": "Signed packages, pinned images, provider and HTTPS",
          "destination": "0.0.0.0/0",
          "direction": "out",
          "port": "80,443",
          "proto": "tcp"
        },
        {
          "comment": "Traefik backend only",
          "destination": "${addresses.pgadmin_backend}/32",
          "direction": "in",
          "port": "80",
          "proto": "tcp",
          "source": "${addresses.ingress_backend}/32"
        },
        {
          "comment": "postgresql approved client db-tools",
          "destination": "${addresses.postgresql_backend}/32",
          "direction": "out",
          "port": "5432",
          "proto": "tcp",
          "source": "${addresses.pgadmin_postgresql}/32"
        },
        {
          "comment": "mariadb approved client db-tools",
          "destination": "${addresses.mariadb_backend}/32",
          "direction": "out",
          "port": "3306",
          "proto": "tcp",
          "source": "${addresses.db_tools_mariadb}/32"
        }
      ],
      "start_on_boot": true,
      "started": true,
      "storage_id": "local-zfs",
      "template_file_id": "local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst",
      "vmid": 202,
      "volumes": {
        "data": {
          "path": "/srv/homelab",
          "size_gib": 2
        }
      }
    },
    "app": {
      "address": "${addresses.pgadmin_management}",
      "exclusive_writer_confirmed": false,
      "health_checks": [
        {
          "name": "CloudBeaver and authentication gateway",
          "argv": [
            "python3",
            "/opt/homelab-app/cloudbeaver-runtime.py",
            "health",
            "--config",
            "/opt/homelab-app/runtime/cloudbeaver-public.json"
          ],
          "expect": "\"cloudbeaver\": \"passed\""
        },
        {
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "15",
            "--resolve",
            "${domains.identity}:443:${addresses.ingress_frontend}",
            "https://${domains.identity}/application/o/pgadmin4/.well-known/openid-configuration"
          ],
          "expect": "authorization_endpoint",
          "name": "Verified HTTPS identity discovery"
        },
        {
          "name": "CloudBeaver HTTPS sign-in redirect",
          "argv": [
            "curl",
            "--retry",
            "30",
            "--retry-delay",
            "2",
            "--retry-all-errors",
            "--retry-max-time",
            "180",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "15",
            "--resolve",
            "${domains.db_tools}:443:${addresses.ingress_frontend}",
            "--output",
            "/dev/null",
            "--write-out",
            "%{http_code}",
            "https://${domains.db_tools}/"
          ],
          "expect": "302"
        }
      ],
      "hostname": "db-tools",
      "kind": "db-tools",
      "mac": "${mac.db-tools.0}",
      "memory_mib": 2048,
      "packages": [
        "docker.io=26.1.5+dfsg1-9+deb13u1",
        "docker-cli=26.1.5+dfsg1-9+deb13u1",
        "docker-compose=2.26.1-4",
        "curl=8.14.1-2+deb13u7"
      ],
      "stack_config": "${inputs}/stack.json",
      "vmid": 202,
      "service_health_checks": {
        "cloudbeaver": [
          {
            "name": "CloudBeaver and authentication gateway",
            "argv": [
              "python3",
              "/opt/homelab-app/cloudbeaver-runtime.py",
              "health",
              "--config",
              "/opt/homelab-app/runtime/cloudbeaver-public.json"
            ],
            "expect": "\"cloudbeaver\": \"passed\""
          },
          {
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "15",
              "--resolve",
              "${domains.identity}:443:${addresses.ingress_frontend}",
              "https://${domains.identity}/application/o/pgadmin4/.well-known/openid-configuration"
            ],
            "expect": "authorization_endpoint",
            "name": "Verified HTTPS identity discovery"
          },
          {
            "name": "CloudBeaver HTTPS sign-in redirect",
            "argv": [
              "curl",
              "--retry",
              "30",
              "--retry-delay",
              "2",
              "--retry-all-errors",
              "--retry-max-time",
              "180",
              "--fail",
              "--silent",
              "--show-error",
              "--max-time",
              "15",
              "--resolve",
              "${domains.db_tools}:443:${addresses.ingress_frontend}",
              "--output",
              "/dev/null",
              "--write-out",
              "%{http_code}",
              "https://${domains.db_tools}/"
            ],
            "expect": "302"
          }
        ]
      },
      "endpoints": {
        "cloudbeaver": {
          "web": "http://${addresses.pgadmin_backend}:80"
        }
      },
      "variant": "cloudbeaver",
      "service_connections": {
        "cloudbeaver.postgresql": {
          "service": "postgresql.postgresql",
          "address": "backend"
        },
        "cloudbeaver.mariadb": {
          "service": "mariadb.mariadb",
          "address": "backend"
        }
      }
    }
  },
  "files": {
    "custody-catalogue.json": "${custody.catalogue}",
    "custody-acceptance.json": "${custody.postgresql_acceptance}"
  },
  "stack": {
    "data_root": "/srv/homelab/data",
    "foundation": {
      "version": 1,
      "oidc_issuer": "https://${domains.identity}/application/o/pgadmin4/",
      "oauth_client_id": "${identity.pgadmin_client}",
      "oauth_name": "authentik",
      "user_claim": "preferred_username",
      "secret_files": {
        "oauth_client_secret": "${inputs}/oauth-client-secret"
      }
    },
    "guest_memory_mib": 2048,
    "kind": "db-tools",
    "services": {
      "cloudbeaver": {
        "memory_mib": 1536,
        "cpus": 1,
        "pids_limit": 512,
        "environment": {},
        "image_ref": "cloudbeaver"
      },
      "auth_gateway": {
        "memory_mib": 128,
        "cpus": 1,
        "pids_limit": 128,
        "environment": {},
        "image_ref": "auth_gateway"
      }
    },
    "timezone": "Australia/Brisbane",
    "variant": "cloudbeaver",
    "cloudbeaver": {
      "bind_address": "${addresses.pgadmin_backend}",
      "public_url": "https://${domains.db_tools}",
      "server_name": "Database Tools",
      "recovery_admin": "local-recovery",
      "heap_mib": 1024,
      "auth_headers": {
        "user": "X-User",
        "team": "X-Team"
      },
      "connections": {
        "postgresql": {
          "name": "PostgreSQL",
          "driver": "postgresql",
          "database": "postgres",
          "sslmode": "prefer"
        },
        "mariadb": {
          "name": "MariaDB",
          "driver": "mariadb",
          "database": ""
        }
      },
      "retained_pgadmin_image": "dpage/pgadmin4@sha256:cefc4cc6b7d9d71a9e81e76fb9d7e14038ab5661b539a190eea1b63fa612589a"
    }
  }
}
