{
  "config": {
    "guest": {
      "vmid": 217,
      "hostname": "mqtt",
      "cpu": 1,
      "memory_mib": 1024,
      "root_gib": 8,
      "storage_id": "local-zfs",
      "template_file_id": "local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst",
      "started": true,
      "start_on_boot": true,
      "boot_order": 50,
      "nesting": true,
      "keyctl": false,
      "dns_servers": [
        "${addresses.dns}",
        "${addresses.fallback_dns}"
      ],
      "interfaces": [
        {
          "bridge": "vmbr0",
          "vlan": 25,
          "mac": "${mac.mqtt.0}",
          "ipv4": "${addresses.mqtt_management}/24",
          "ipv6": "manual",
          "gateway": "${gateways.management}"
        },
        {
          "bridge": "vmbr30",
          "vlan": null,
          "mac": "${mac.mqtt.1}",
          "ipv4": "${addresses.mqtt_backend}/24",
          "ipv6": "manual"
        },
        {
          "bridge": "vmbr1",
          "vlan": 41,
          "mac": "${mac.mqtt.2}",
          "ipv4": "${addresses.mqtt_frontend}/24",
          "ipv6": "manual"
        }
      ],
      "volumes": {
        "data": {
          "path": "/srv/homelab",
          "size_gib": 4
        }
      },
      "rules": [
        {
          "direction": "in",
          "proto": "tcp",
          "port": "22",
          "source": "${addresses.runner}/32",
          "destination": "${addresses.mqtt_management}/32",
          "comment": "Deployment runner SSH only"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "destination": "${addresses.dns}/32",
          "comment": "Selected internal DNS only"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "destination": "${addresses.dns}/32",
          "comment": "Selected internal DNS only"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "53",
          "destination": "${addresses.fallback_dns}/32",
          "comment": "Selected internal DNS only"
        },
        {
          "direction": "out",
          "proto": "udp",
          "port": "53",
          "destination": "${addresses.fallback_dns}/32",
          "comment": "Selected internal DNS only"
        },
        {
          "direction": "out",
          "proto": "tcp",
          "port": "80,443",
          "source": "${addresses.mqtt_management}/32",
          "destination": "0.0.0.0/0",
          "interface": "net0",
          "comment": "Packages, selected upstream image and provider HTTPS"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883",
          "comment": "Declared backend MQTT client",
          "source": "${addresses.automation_backend}/32",
          "destination": "${addresses.mqtt_backend}/32",
          "interface": "net1"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883",
          "comment": "Declared backend MQTT client",
          "source": "${addresses.zigbee_backend}/32",
          "destination": "${addresses.mqtt_backend}/32",
          "interface": "net1"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883,8000",
          "comment": "Retained authenticated MQTT client",
          "source": "${networks.home}/24",
          "destination": "${addresses.mqtt_frontend}/32",
          "interface": "net2"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883,8000",
          "comment": "Retained authenticated MQTT client",
          "source": "${networks.iot}/24",
          "destination": "${addresses.mqtt_frontend}/32",
          "interface": "net2"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883,8000",
          "comment": "Retained authenticated MQTT client",
          "source": "${addresses.pironman_apps}/32",
          "destination": "${addresses.mqtt_frontend}/32",
          "interface": "net2"
        },
        {
          "direction": "in",
          "proto": "tcp",
          "port": "1883,8000",
          "comment": "Retained authenticated MQTT client",
          "source": "${addresses.zigbeepi_apps}/32",
          "destination": "${addresses.mqtt_frontend}/32",
          "interface": "net2"
        }
      ]
    },
    "app": {
      "kind": "mqtt",
      "vmid": 217,
      "hostname": "mqtt",
      "memory_mib": 1024,
      "address": "${addresses.mqtt_management}",
      "mac": "${mac.mqtt.0}",
      "packages": [
        "docker.io=26.1.5+dfsg1-9+deb13u1",
        "docker-cli=26.1.5+dfsg1-9+deb13u1",
        "docker-compose=2.26.1-4",
        "curl=8.14.1-2+deb13u7"
      ],
      "stack_config": "${inputs}/stack.json",
      "exclusive_writer_confirmed": false,
      "frontend_routing": {
        "address": "${addresses.mqtt_frontend}/24",
        "gateway": "${gateways.mqtt}",
        "mac": "${mac.mqtt.2}"
      },
      "published_services": {
        "mqtt": {
          "hostname": "broker.mqtt",
          "addresses": {
            "frontend": "${addresses.mqtt_frontend}",
            "backend": "${addresses.mqtt_backend}"
          },
          "dns_address": "frontend",
          "protocol": "tcp",
          "port": 1883
        }
      },
      "health_checks": [
        {
          "name": "Retained MQTT credentials accepted and anonymous refused",
          "argv": [
            "python3",
            "/opt/homelab-app/automation-health.py",
            "mqtt-broker"
          ],
          "expect": "\"read_only_probe\": \"passed\""
        }
      ],
      "service_health_checks": {
        "mqtt": [
          {
            "name": "Retained MQTT credentials accepted and anonymous refused",
            "argv": [
              "python3",
              "/opt/homelab-app/automation-health.py",
              "mqtt-broker"
            ],
            "expect": "\"read_only_probe\": \"passed\""
          }
        ]
      }
    }
  },
  "files": {},
  "stack": {
    "kind": "mqtt",
    "data_root": "/srv/homelab/data",
    "guest_memory_mib": 1024,
    "timezone": "Australia/Brisbane",
    "mqtt": {
      "credential_file": "${paths.mqtt_probe}"
    },
    "services": {
      "mqtt": {
        "memory_mib": 256,
        "cpus": 1,
        "pids_limit": 128,
        "environment": {},
        "extra_mounts": [],
        "image_ref": "mqtt"
      }
    }
  }
}
