{
  "name": "homelab-dns",
  "services": {
    "pihole": {
      "cpus": 1,
      "environment": {
        "FTLCONF_dhcp_active": "false",
        "FTLCONF_dns_upstreams": "127.0.0.1#5335",
        "TZ": "Etc/UTC"
      },
      "image": "pihole/pihole@sha256:70a9c11171ded2eee735d88c127996da209284a329d50f5ae59c06b861d401b3",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "256m",
      "network_mode": "host",
      "pids_limit": 128,
      "pull_policy": "missing",
      "restart": "always",
      "stop_grace_period": "60s",
      "volumes": [
        "/srv/homelab/data/pihole:/etc/pihole"
      ]
    },
    "unbound": {
      "cpus": 1,
      "environment": {
        "TZ": "Etc/UTC"
      },
      "image": "mvance/unbound@sha256:76906da36d1806f3387338f15dcf8b357c51ce6897fb6450d6ce010460927e90",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "256m",
      "pids_limit": 128,
      "ports": [
        "127.0.0.1:5335:53/tcp",
        "127.0.0.1:5335:53/udp"
      ],
      "pull_policy": "missing",
      "restart": "always",
      "stop_grace_period": "60s",
      "volumes": [
        "/srv/homelab/data/unbound:/opt/unbound/etc/unbound"
      ]
    }
  }
}
